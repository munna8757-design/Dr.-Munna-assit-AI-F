# Configure these in your hosting provider's secret/environment settings.
# Never commit a real key or put GOOGLE_API_KEY inside the Android APK.
PORT=8080
APP_API_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_API_KEY=put-your-Gemini-API-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Optional comma-separated browser origins. Leave empty for native Android clients.
ALLOWED_ORIGINS=
